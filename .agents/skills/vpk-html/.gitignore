# vpk-html local artifacts
# Generated outputs are committed (gallery thumbnails, demo PNGs, ported diagrams)
# so the gallery renders without a build step. Anything below is local-only.

.DS_Store
*.log

# Derived, on-demand PDF exports (build.mjs --pdf) are never committed — the
# single-file HTML is the source of truth; PDF is regenerated when needed.
*.pdf

# Local payload scratch space (not part of the example fixture set)
/local/
/.tmp/

# Routine durable renders live under artifacts/vpk-html/<slug>/ at the repo
# root. If anyone redirects local experiments inside this skill, keep them
# untracked.
/output-scratch/
